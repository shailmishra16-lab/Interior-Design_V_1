# ==============================================================================
# Aaranya Interiors — Environment Variables Template
# Copy this file to .env.local for local development, or configure in Vercel
# Project Settings -> Environment Variables. NEVER commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server-Side Google Apps Script Integration (REQUIRED FOR LIVE/DEMO SHEETS)
# ------------------------------------------------------------------------------
# Deploy google-apps-script/Code.gs as a Web App ("Execute as: Me",
# "Who has access: Anyone") and paste the Web App URL below.
APPS_SCRIPT_WEBHOOK_URL=""

# Optional separate Apps Script Web App URL for Demonstration Mode submissions
# so test leads never mix with live customer leads.
APPS_SCRIPT_DEMO_WEBHOOK_URL=""

# Shared secret token validated inside Google Apps Script doPost(e).
# Generate a strong 32+ char random string and set the same value in
# Google Apps Script -> Project Settings -> Script Properties (WEBHOOK_SECRET).
APPS_SCRIPT_SECRET=""

# ------------------------------------------------------------------------------
# 2. Application, Demo Branding & SEO Configuration
# ------------------------------------------------------------------------------
# Public canonical URL of the deployed website (used for sitemap & OpenGraph)
APP_URL="http://localhost:3000"

# Set to "false" when deploying for a live verified interior design client
VITE_IS_DEMO_SITE="true"
VITE_DEMO_NOINDEX="true"
VITE_DEFAULT_DEMO_MODE="true"

# Set to "true" ONLY when verified business phone, email & social links are provided
VITE_VERIFIED_CONTACT="false"

# Optional client contact overrides (used when VITE_VERIFIED_CONTACT="true" or for WhatsApp)
VITE_WHATSAPP_NUMBER=""
VITE_STUDIO_PHONE=""
VITE_STUDIO_PHONE_RAW=""
VITE_STUDIO_EMAIL=""
